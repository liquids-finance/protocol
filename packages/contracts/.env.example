# =============================================================================
#  Liquids.finance deployment env template
# =============================================================================
#  Copy this file to `.env` (already in .gitignore) and fill in the values you
#  procure. Two-stage deploy:
#    1) DeployCore.s.sol  — needs the chain-level addresses (top section)
#    2) CreateDemoPool.s.sol — needs the demo market addresses (bottom section)
# =============================================================================


# --- RPC endpoints ---------------------------------------------------------
# foundry.toml's [rpc_endpoints] table reads these names. After populating,
# you can run: forge script ... --rpc-url x_layer_mainnet
X_LAYER_MAINNET_RPC=https://rpc.xlayer.tech
X_LAYER_TESTNET_RPC=https://testrpc.xlayer.tech


# --- Stage 1: DeployCore ---------------------------------------------------

# Deployer EOA private key (0x-prefixed, 64 hex chars). Must be funded with the
# chain's gas token (OKB on X Layer). NEVER commit this. If you don't have an
# EOA yet:
#   cast wallet new
PRIVATE_KEY=0x

# Uniswap V4 PoolManager on X Layer mainnet (confirmed live).
V4_POOL_MANAGER=0x360e68faccca8ca495c1b759fd9eee466db9fb32

# CREATE2 deployer used to mine the hook's magic address. Default is the
# Arachnid deterministic deployer, present on most EVM chains:
#   0x4e59b44847b379578588920cA78FbF26c0B4956C
# Override only if your target chain doesn't have it deployed.
# CREATE2_DEPLOYER=

# NOTE: OKLink source-verification does NOT require an API key — see foundry.toml's
# [etherscan] block (key is set to ""). No OKLINK_API_KEY env var is needed.


# --- Stage 2: CreateDemoPool ----------------------------------------------

# Hook address from Stage 1 (DeployCore prints it). Copy/paste here.
HOOK=0x

# Pool tokens. The script auto-sorts them by address to satisfy V4's
# currency0 < currency1 invariant; the BORROW_SIDE label below is resolved
# relative to A/B, not to the sorted position.
#
# X Layer mainnet:
TOKEN_A=0xE7B000003A45145decf8a28FC755aD5eC5EA025A   # xETH (18 decimals)
TOKEN_B=0x779Ded0c9e1022225f8E0630b35a9b54bE713736   # USDT0 (6 decimals)

# Chainlink-compatible price feeds. Must update at least every
# MAX_PRICE_STALENESS = 1 hour or supply/borrow/withdraw will revert.
ORACLE_A=0x8b85b50535551F8E8cDAF78dA235b5Cf1005907b  # ETH / USD on X Layer
ORACLE_B=0x673b428Fd1df93a6F77fA7ea1F8eeD8A4Ff36b9f  # USDT / USD on X Layer

# Which side is borrowable. "B" = users borrow USDT0 against xETH-shaped
# collateral. Since USDT0 sorts lower than xETH, the script will resolve this
# to borrowCurrencyIndex = 0 automatically.
BORROW_SIDE=B

# Initial pool tick. Must be a multiple of TICK_SPACING.
# Math: tick t encodes price ratio (currency1 / currency0) = 1.0001^t.
# With USDT0 sorting as currency0 (6 dec) and xETH as currency1 (18 dec):
#   tick 200200  →  ETH ≈ $1989 per USDT
#   tick 200300  →  ETH ≈ $2009 per USDT
# 200200 is what the test suite uses — well-exercised and gas-aligned.
INITIAL_TICK=200200

# Pool fee in basis points (0.05% default). Standard V4 fees: 100, 500, 3000, 10000.
# POOL_FEE=500

# Tick spacing. Standard pairing: fee 500 -> tickSpacing 10; fee 3000 -> 60; fee 10000 -> 200.
# TICK_SPACING=10
